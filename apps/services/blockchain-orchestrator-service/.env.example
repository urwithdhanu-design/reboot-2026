# Blockchain Orchestrator Service
SERVER_PORT=8088

# GCUL sidecar
GCUL_SIDECAR_URL=http://127.0.0.1:8091

# Ethereum (Alchemy Sepolia) — insurer mint only; see docs/BLOCKCHAIN-INSURER-MINT.md

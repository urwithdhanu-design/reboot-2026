# syntax=docker/dockerfile:1
# Daml Canton local sandbox for Cloud Run (JSON Ledger API on PORT).
FROM digitalasset/daml-sdk:2.9.3 AS build
USER root
WORKDIR /build
COPY canton/daml/ .
RUN daml build

FROM digitalasset/daml-sdk:2.9.3
USER root
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3-minimal \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /sandbox
COPY --from=build /build/.daml/dist/gcul-policy-0.1.0.dar /sandbox/gcul-policy.dar
COPY canton/docker/start-sandbox.sh /start-sandbox.sh
RUN sed 's/\r$//' /start-sandbox.sh > /sandbox/start.sh \
  && chmod +x /sandbox/start.sh \
  && chown -R daml:daml /sandbox
ENV PORT=8080
EXPOSE 8080
USER daml
CMD ["bash", "/sandbox/start.sh"]

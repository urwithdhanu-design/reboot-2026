                                     ]
                    },
                    {
                        "ignore":  [
                                       "firebase.json",
                                       "**/.*",
                                       "**/node_modules/**"
                                   ],
                        "public":  "apps/admin/dist",
                        "target":  "admin",
                        "rewrites":  [
                                         {
                                             "destination":  "/index.html",
                                             "source":  "**"
                                         }
                                     ]
                    }
                ]
}
